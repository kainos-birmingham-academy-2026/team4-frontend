<dialog class="confirmation-dialog" id="confirmation-dialog" aria-labelledby="confirmation-dialog-title">
  <div class="confirmation-dialog-content">
    <h2 id="confirmation-dialog-title">Please confirm</h2>
    <p data-confirmation-message></p>
    <div class="confirmation-dialog-actions">
      <button type="button" class="btn btn-secondary" data-confirmation-cancel>Cancel</button>
      <button type="button" class="btn" data-confirmation-confirm>Confirm</button>
    </div>
  </div>
</dialog>
