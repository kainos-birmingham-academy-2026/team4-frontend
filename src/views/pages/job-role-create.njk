{% extends "layouts/base.njk" %}

{% block content %}
<section class="page-section">
  <div class="container">
    <div class="page-header">
      <h1>Add New Job Role</h1>
      <p>Create a role for an existing capability and band.</p>
    </div>

    {% if errors.general %}
      <p class="form-error" role="alert">{{ errors.general }}</p>
    {% endif %}

    <form method="post" action="/job-roles" class="form-card">
      <div class="form-group">
        <label for="roleName">Job role name</label>
        <input class="form-control" id="roleName" name="roleName" type="text" value="{{ formValues.roleName }}" required />
        {% if errors.roleName %}<p class="form-error">{{ errors.roleName }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="description">Job specification summary</label>
        <textarea id="description" name="description" rows="5" required>{{ formValues.description }}</textarea>
        {% if errors.description %}<p class="form-error">{{ errors.description }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="sharepointUrl">SharePoint link</label>
        <input class="form-control" id="sharepointUrl" name="sharepointUrl" type="url" value="{{ formValues.sharepointUrl }}" required />
        {% if errors.sharepointUrl %}<p class="form-error">{{ errors.sharepointUrl }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="responsibilities">Responsibilities</label>
        <textarea
          id="responsibilities"
          name="responsibilities"
          rows="6"
          placeholder="Enter one responsibility per line"
          required
        >{{ formValues.responsibilities }}</textarea>
        {% if errors.responsibilities %}<p class="form-error">{{ errors.responsibilities }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="numberOfOpenPositions">Number of open positions</label>
        <input
          class="form-control"
          id="numberOfOpenPositions"
          name="numberOfOpenPositions"
          type="number"
          min="0"
          step="1"
          value="{{ formValues.numberOfOpenPositions }}"
          required
        />
        {% if errors.numberOfOpenPositions %}<p class="form-error">{{ errors.numberOfOpenPositions }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="location">Location</label>
        <input class="form-control" id="location" name="location" type="text" value="{{ formValues.location }}" required />
        {% if errors.location %}<p class="form-error">{{ errors.location }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="closingDate">Closing date</label>
        <input id="closingDate" name="closingDate" type="date" value="{{ formValues.closingDate }}" required />
        {% if errors.closingDate %}<p class="form-error">{{ errors.closingDate }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="capabilityId">Capability</label>
        <select id="capabilityId" name="capabilityId" required>
          <option value="">Select a capability</option>
          {% for capability in options.capabilities %}
            <option
              value="{{ capability.id }}"
              {% if formValues.capabilityId == capability.id | string %}selected{% endif %}
            >
              {{ capability.name }}
            </option>
          {% endfor %}
        </select>
        {% if errors.capabilityId %}<p class="form-error">{{ errors.capabilityId }}</p>{% endif %}
      </div>

      <div class="form-group">
        <label for="bandId">Band</label>
        <select id="bandId" name="bandId" required>
          <option value="">Select a band</option>
          {% for band in options.bands %}
            <option
              value="{{ band.id }}"
              {% if formValues.bandId == band.id | string %}selected{% endif %}
            >
              {{ band.name }}
            </option>
          {% endfor %}
        </select>
        {% if errors.bandId %}<p class="form-error">{{ errors.bandId }}</p>{% endif %}
      </div>

      <div class="form-group form-actions">
        <button type="submit">Create job role</button>
        <a href="/job-roles" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</section>
{% endblock %}