{% extends "layouts/base.njk" %}

{% block content %}
  <section class="auth-page auth-page-login">
    <div class="container auth-page-container">
      <div class="auth-layout">
        <div class="auth-form-panel">
          <div class="auth-page-header">
            <p class="auth-eyebrow">Kainos Careers</p>
            <h1>Sign In</h1>
            <p>Sign in to continue exploring opportunities and managing your applications.</p>
          </div>

          {% if registrationSuccessMessage %}
            <div class="form-success-summary" role="status" aria-live="polite">
              <p>{{ registrationSuccessMessage }}</p>
            </div>
          {% endif %}

          {% if errorMessage %}
            <div class="form-error-summary" role="status" aria-live="polite">
              <p>{{ errorMessage }}</p>
            </div>
          {% endif %}

          <form action="/login" method="post">
            <div class="form-group">
              <label for="email">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="your.email@example.com"
              />
            </div>

            <div class="form-group">
              <label for="password">Password</label>
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Enter your password"
              />
            </div>

            <div class="form-actions">
              <button type="submit" class="btn">Sign In</button>
            </div>

            <div class="form-link">
              Don't have an account? <a href="/register">Create one now</a>
            </div>
          </form>
        </div>

        <aside class="auth-feature-panel auth-quote-panel" aria-labelledby="auth-quote-heading">
          <div>
            <p class="auth-feature-kicker">Careers at Kainos</p>
            <h2 id="auth-quote-heading">Build a career with room to grow.</h2>
          </div>
          <figure class="auth-quote">
            <blockquote>
              "The best work happens when curious people are trusted to keep learning, ask better questions and make a difference together."
            </blockquote>
            <figcaption>
              <span class="auth-quote-rule" aria-hidden="true"></span>
              Kainos Careers
            </figcaption>
          </figure>
        </aside>
      </div>
    </div>
  </section>
{% endblock %}
