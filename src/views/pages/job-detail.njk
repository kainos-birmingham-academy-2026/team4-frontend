{% extends "layouts/base.njk" %}

{% block content %}
  <section class="page-section job-detail-page">
    <div class="container">
      {% if applied %}
      <div class="applied-banner" role="status">
        {% if applicationStatus == "In Progress" %}
        ✅ Your application has been submitted and is now in progress.
        {% else %}
        ✅ Your application status is {{ applicationStatus }}.
        {% endif %}
      </div>
      {% endif %}
      {% if applicationUnavailable %}
      <div class="form-error-summary" role="alert" aria-live="polite">
        <p>This role is no longer accepting applications.</p>
      </div>
      {% endif %}
      <a href="/job-roles" class="breadcrumb-link">← Back to Job Roles</a>

      <div class="job-detail-header">
        <div>
          <h1 class="job-detail-title">{{ job.roleName }}</h1>
        </div>
        {% if displayStatus == "Open" %}
        <span class="job-status-badge open">{{ displayStatus }}</span>
        {% elif displayStatus == "In Progress" %}
        <span class="job-status-badge in-progress">{{ displayStatus }}</span>
        {% elif displayStatus == "Hired" %}
        <span class="job-status-badge hired">{{ displayStatus }}</span>
        {% elif displayStatus == "Rejected" %}
        <span class="job-status-badge rejected">{{ displayStatus }}</span>
        {% else %}
        <span class="job-status-badge closed">{{ displayStatus }}</span>
        {% endif %}
      </div>

      {% if isAdmin %}
      <div class="job-detail-actions">
        <a href="/job-roles/{{ job.jobRoleId }}/edit" class="btn">Edit this role</a>
        <form method="post" action="/job-roles/{{ job.jobRoleId }}/delete" data-confirmation-message="Are you sure you want to delete this job role?">
          <button type="submit" class="btn btn-secondary">Delete this role</button>
        </form>
      </div>
      {% endif %}

      {% set applicationsPanel %}
      {% if isAdmin %}
      <details class="applications-section" {% if assessmentSuccess or assessmentError or fitAssessmentSuccess %}open{% endif %}>
        <summary class="applications-summary">Applications <span class="application-count">{{ applications.length }} applicant{% if applications.length != 1 %}s{% endif %}</span></summary>
        <div class="applications-toolbar">
          <form method="post" action="/job-roles/{{ job.jobRoleId }}/applications/fit-assessments">
            <button type="submit" class="btn btn-small" data-confirmation-message="Assess all applicants without a completed AI fit result?">Assess applicants</button>
          </form>
          <a class="fit-sort-link" href="/job-roles/{{ job.jobRoleId }}{% if fitSort == 'asc' %}?fitSort=desc{% else %}?fitSort=asc{% endif %}">Sort fit {% if fitSort == 'asc' %}descending{% elif fitSort == 'desc' %}ascending{% else %}ascending{% endif %}</a>
        </div>
        <p class="fit-disclaimer">AI-generated decision support only. Recruiters remain responsible for every employment decision.</p>
        {% if assessmentSuccess %}
          <div class="form-success-summary" role="status" aria-live="polite">
            <p>{{ assessmentSuccess }}</p>
          </div>
        {% endif %}
        {% if fitAssessmentSuccess %}
          <div class="form-success-summary" role="status" aria-live="polite">
            <p>{{ fitAssessmentSuccess }}</p>
          </div>
        {% endif %}
        {% if assessmentError %}
          <div class="form-error-summary" role="alert" aria-live="polite">
            <p>{{ assessmentError }}</p>
          </div>
        {% endif %}

        {% if applications.length %}
          <div class="applications-list">
            {% for application in applications %}
              <article class="application-item">
                <div class="application-main">
                  <button type="button" class="application-applicant review-button" data-review-dialog-open="application-{{ application.applicationId }}">{{ application.applicantEmail }}</button>
                  <time datetime="{{ application.createdAt }}">Applied {{ application.createdAt | formatDate }}</time>
                </div>

                <div class="application-actions">
                  <button type="button" class="review-button" data-review-dialog-open="application-{{ application.applicationId }}">View application</button>
                  <div class="fit-result">
                    {% if application.fitStatus == "Complete" %}
                      <span class="fit-score">AI fit {{ application.fitScore }}%</span>
                      <button type="button" class="review-button" data-review-dialog-open="fit-{{ application.applicationId }}">View fit assessment</button>
                    {% elif application.fitStatus %}
                      <span class="fit-status">AI fit {{ application.fitStatus }}</span>
                    {% else %}
                      <span class="fit-status">AI fit Pending</span>
                    {% endif %}
                  </div>
                  {% if application.status == "In Progress" %}
                    <span class="application-status in-progress">{{ application.status }}</span>
                    <form method="post" action="/job-roles/{{ job.jobRoleId }}/applications/{{ application.applicationId }}/hire" data-confirmation-message="Hire this applicant?">
                      <button type="submit" class="btn btn-small">Hire</button>
                    </form>
                    <form method="post" action="/job-roles/{{ job.jobRoleId }}/applications/{{ application.applicationId }}/reject" data-confirmation-message="Reject this applicant?">
                      <button type="submit" class="btn btn-small btn-secondary">Reject</button>
                    </form>
                  {% elif application.status == "Hired" %}
                    <span class="application-status hired">Hired</span>
                  {% else %}
                    <span class="application-status rejected">Rejected</span>
                  {% endif %}
                </div>

                <template id="application-{{ application.applicationId }}">
                  <div class="review-dialog-heading">
                    <p class="review-dialog-eyebrow">Application</p>
                    <h2>{{ application.applicantEmail }}</h2>
                  </div>
                  <section class="review-dialog-section" aria-labelledby="application-message-heading-{{ application.applicationId }}">
                    <h3 id="application-message-heading-{{ application.applicationId }}">Application message</h3>
                    <p class="review-dialog-message">{{ application.message }}</p>
                  </section>
                </template>

                {% if application.fitStatus == "Complete" %}
                  <template id="fit-{{ application.applicationId }}">
                    <div class="review-dialog-heading">
                      <p class="review-dialog-eyebrow">AI fit assessment</p>
                      <h2>{{ application.applicantEmail }}</h2>
                      <span class="fit-score">AI fit {{ application.fitScore }}%</span>
                    </div>
                    <p class="fit-disclaimer">AI-generated decision support only. Recruiters remain responsible for every employment decision.</p>
                    <section class="review-dialog-section">
                      <h3>Assessment summary</h3>
                      <p>{{ application.fitSummary }}</p>
                    </section>
                    <div class="review-dialog-columns">
                      <section class="review-dialog-section">
                        <h3>Matching strengths</h3>
                        <ul>{% for strength in application.fitStrengths %}<li>{{ strength }}</li>{% endfor %}</ul>
                      </section>
                      <section class="review-dialog-section">
                        <h3>Missing or unclear requirements</h3>
                        <ul>{% for gap in application.fitGaps %}<li>{{ gap }}</li>{% endfor %}</ul>
                      </section>
                    </div>
                    {% if application.fitAssessedAt %}<p class="review-dialog-metadata">Assessed {{ application.fitAssessedAt | formatDate }} using {{ application.fitModel }} (prompt {{ application.fitPromptVersion }}).</p>{% endif %}
                  </template>
                {% endif %}
              </article>
            {% endfor %}
          </div>
          <dialog class="application-review-dialog" id="application-review-dialog" aria-labelledby="application-review-dialog-title">
            <div class="application-review-dialog-content" data-review-dialog-content></div>
            <form method="dialog" class="application-review-dialog-actions">
              <button type="submit" class="btn btn-secondary" data-review-dialog-close>Close</button>
            </form>
          </dialog>
        {% else %}
          <p class="empty-applications">No applications have been submitted for this role.</p>
        {% endif %}
      </details>
      {% endif %}
      {% endset %}

      <div class="job-detail-meta">
        <div class="meta-item">
          <span class="meta-label">Location</span>
          <span class="meta-value">{{ job.location }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Band</span>
          <span class="meta-value">{{ job.band }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Capability</span>
          <span class="meta-value">{{ job.capability }}</span>
        </div>
        {% if job.status == "Open" %}
        <div class="meta-item">
          <span class="meta-label">Closing Date</span>
          <span class="meta-value">{{ job.closingDate | formatDate}}</span>
        </div>
        {% endif %}
      </div>

      <div class="job-detail-grid">
        <div class="job-detail-main">

          <section class="detail-section">
            <h2>About This Role</h2>
            <p>{{ job.description }}</p>
            <p><a href="{{ job.sharepointUrl }}" target="_blank" rel="noopener noreferrer">View this role in SharePoint (opens in a new tab).</a></p>
          </section>

          <section class="detail-section">
            <h2>Key Responsibilities</h2>
            <ul class="responsibilities-list">
              {% for responsibility in job.responsibilities %}
                <li>{{ responsibility }}</li>
              {% endfor %}
            </ul>
          </section>

        </div>
        <aside class="job-detail-sidebar">
          {% if job.status == "Open" and job.numberOfOpenPositions > 0 %}
          <div class="sidebar-card">
            <h3>Open Positions</h3>
            <p>We have {{ job.numberOfOpenPositions }} open positions for this role.</p>
            {% if isApplicant and not applied %}
            <a href="/job-roles/{{ job.jobRoleId }}/apply" class="btn" style="width: 100%; display: block; text-align: center;">Apply Now</a>
            {% endif %}
          </div>
          {% endif %}

          <div class="sidebar-card">
            <h3>Questions?</h3>
            <p>Contact our recruitment team</p>
            <a href="mailto:careers@kainos.com" class="contact-link">careers@kainos.com</a>
          </div>
        </aside>
      </div>
      {{ applicationsPanel | safe }}
    </div>
  </section>
{% endblock %}
