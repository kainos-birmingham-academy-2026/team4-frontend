{% extends "layouts/base.njk" %}

{% block content %}
  <section class="page-section">
    <div class="container">
      <a href="/job-roles" class="breadcrumb-link">← Back to Job Roles</a>

      <div class="job-detail-header">
        <div>
          <h1 class="job-detail-title">{{ job.roleName }}</h1>
        </div>
        {% if job.status == "Open" %}
        <span class="job-status-badge open">{{ job.status }}</span>
        {% else %}
        <span class="job-status-badge closed">{{ job.status }}</span>
        {% endif %}
      </div>

      <div class="job-detail-meta">
        <div class="meta-item">
          <span class="meta-label">📍 Location</span>
          <span class="meta-value">{{ job.location }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">⏱️ Band</span>
          <span class="meta-value">{{ job.band }}</span>
        </div>
        <div class="meta-item">
          <span class="meta-label">💪 Capability</span>
          <span class="meta-value">{{ job.capability }}</span>
        </div>
        {% if job.status == "Open" %}
        <div class="meta-item">
          <span class="meta-label">⌛ Closing Date</span>
          <span class="meta-value">{{ job.closingDate | formatDate}}</span>
        </div>
        {% endif %}
      </div>

      <div class="job-detail-grid">
        <div class="job-detail-main">

          <section class="detail-section">
            <h2>About This Role</h2>
            <p>{{ job.description }}</p>
            <p><a href={{ job.sharepointUrl }}>View this role in SharePoint.</a></p>
          </section>

          <section class="detail-section">
            <h2>Key Responsibilities</h2>
            <ul class="responsibilities-list">
              {% for responsibility in job.responsibilities %}
                <li>{{ responsibility }}</li>
              {% endfor %}
            </ul>
          </section>

        <aside class="job-detail-sidebar">
          {% if job.status == "Open" %}
          <div class="sidebar-card">
            <h3>Ready to Apply?</h3>
            <p>We have {{ job.numberOfOpenPositions }} open positions for this role. Take the next step in your career at Kainos:</p>
            <button class="btn" style="width: 100%;">Apply Now</button>
            <button class="btn btn-secondary" style="width: 100%; margin-top: 0.75rem;">Save Job</button>
          </div>
          {% endif %}

          <div class="sidebar-card">
            <h3>Share This Role</h3>
            <p>Know someone perfect for this position?</p>
            <div class="share-buttons">
              <a href="#" class="share-btn" title="Share on LinkedIn">in</a>
              <a href="#" class="share-btn" title="Share on Twitter">𝕏</a>
              <a href="#" class="share-btn" title="Share via Email">✉</a>
            </div>
          </div>

          <div class="sidebar-card">
            <h3>Questions?</h3>
            <p>Contact our recruitment team</p>
            <a href="mailto:careers@kainos.com" class="contact-link">careers@kainos.com</a>
          </div>
        </aside>
      </div>
    </div>
  </section>
{% endblock %}
