{% extends "layouts/base.njk" %}

{% block content %}
  <section class="page-section">
    <div class="container">
      <div style="max-width: 500px; margin: 0 auto;">
        <div class="page-header">
          <h1>Create Your Account</h1>
          <p>Join Kainos Careers and start exploring exciting opportunities</p>
        </div>

        <div class="form-card">
          {% if errors.general %}
            <div class="form-error-summary" role="alert" aria-live="polite">
              <p>{{ errors.general }}</p>
            </div>
          {% endif %}

          <form action="/register" method="post" novalidate>
            <div class="form-group {% if errors.email %}form-group-error{% endif %}">
              <label for="email">Email Address</label>
              {% if errors.email %}
                <p class="form-error-text" id="email-error">{{ errors.email }}</p>
              {% endif %}
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="john.doe@example.com"
                value="{{ form.email }}"
                {% if errors.email %}aria-describedby="email-error" aria-invalid="true"{% endif %}
              />
            </div>

            <div class="form-group {% if errors.password %}form-group-error{% endif %}">
              <label for="password">Password</label>
              {% if errors.password %}
                <p class="form-error-text" id="password-error">{{ errors.password }}</p>
              {% endif %}
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Enter a strong password"
                {% if errors.password %}aria-describedby="password-error" aria-invalid="true"{% endif %}
              />
            </div>

            <div class="form-group {% if errors.confirmPassword %}form-group-error{% endif %}">
              <label for="confirmPassword">Confirm Password</label>
              {% if errors.confirmPassword %}
                <p class="form-error-text" id="confirm-password-error">{{ errors.confirmPassword }}</p>
              {% endif %}
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                placeholder="Confirm your password"
                {% if errors.confirmPassword %}aria-describedby="confirm-password-error" aria-invalid="true"{% endif %}
              />
            </div>

            <div class="form-actions">
              <button type="submit" class="btn">Create Account</button>
            </div>

            <div class="form-link">
              Already have an account? <a href="/login">Sign in here</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
{% endblock %}
