{% extends "layouts/base.njk" %}

{% block content %}
  <section class="auth-page auth-page-register">
    <div class="container auth-page-container">
      <div class="auth-layout auth-layout-register">
        <aside class="auth-feature-panel auth-quote-panel auth-register-quote-panel" aria-labelledby="registration-quote-heading">
          <div>
            <p class="auth-feature-kicker">Your next chapter</p>
            <h2 id="registration-quote-heading">Start somewhere that expects you to grow.</h2>
          </div>
          <figure class="auth-quote">
            <blockquote>
              "A great career is built one opportunity at a time. Bring your perspective, learn with others and do work that matters."
            </blockquote>
            <figcaption>
              <span class="auth-quote-rule" aria-hidden="true"></span>
              Kainos Careers
            </figcaption>
          </figure>
        </aside>

        <div class="auth-form-panel">
          <div class="auth-page-header">
            <p class="auth-eyebrow">Kainos Careers</p>
            <h1>Create Your Account</h1>
            <p>Join Kainos Careers and start exploring opportunities that suit you.</p>
          </div>

          {% if errors.general %}
            <div class="form-error-summary" role="alert" aria-live="polite">
              <p>{{ errors.general }}</p>
            </div>
          {% endif %}

          <form action="/register" method="post" novalidate>
            <div class="form-group {% if errors.email %}form-group-error{% endif %}">
              <label for="email">Email Address</label>
              {% if errors.email %}
                <p class="form-error-text" id="email-error">{{ errors.email }}</p>
              {% endif %}
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="john.doe@example.com"
                value="{{ form.email }}"
                {% if errors.email %}aria-describedby="email-error" aria-invalid="true"{% endif %}
              />
            </div>

            <div class="form-group {% if errors.password %}form-group-error{% endif %}">
              <label for="password">Password</label>
              {% if errors.password %}
                <p class="form-error-text" id="password-error">{{ errors.password }}</p>
              {% endif %}
              <input
                type="password"
                id="password"
                name="password"
                required
                placeholder="Enter a strong password"
                {% if errors.password %}aria-describedby="password-error" aria-invalid="true"{% endif %}
              />
            </div>

            <div class="form-group {% if errors.confirmPassword %}form-group-error{% endif %}">
              <label for="confirmPassword">Confirm Password</label>
              {% if errors.confirmPassword %}
                <p class="form-error-text" id="confirm-password-error">{{ errors.confirmPassword }}</p>
              {% endif %}
              <input
                type="password"
                id="confirmPassword"
                name="confirmPassword"
                required
                placeholder="Confirm your password"
                {% if errors.confirmPassword %}aria-describedby="confirm-password-error" aria-invalid="true"{% endif %}
              />
            </div>

            <div class="form-actions">
              <button type="submit" class="btn">Create Account</button>
            </div>

            <div class="form-link">
              Already have an account? <a href="/login">Sign in here</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
{% endblock %}
