{% extends "layouts/base.njk" %}

{% block content %}
  <section class="page-section">
    <div class="container">
      <div class="page-header">
        <h1>Explore Job Roles</h1>
        <p>Discover exciting career opportunities across all departments and locations at Kainos</p>
      
        {% if isAdmin %}
          <p>
            <a href="/job-roles/new" class="btn">Add new role</a>
          </p>
        {% endif %}
      </div>

      {% if successMessage %}
        <div class="form-success-summary" role="status" aria-live="polite">
          <p>{{ successMessage }}</p>
        </div>
      {% endif %}

      <div style="margin-bottom: 2rem;">
        <form class="search-card" action="/job-roles" method="get" aria-label="Filter job roles">
          <label for="filter-role-name">Search by role name</label>
          <div class="search-row" style="width: 100%;">
            <input
              id="filter-role-name"
              name="roleName"
              type="text"
              value="{{ filters.roleName }}"
              placeholder="e.g. Software Engineer, React, Data"
              style="width: 100%;"
            />
            <button type="submit">Search</button>
          </div>

          {% set groups = [
            { legend: "Capability", name: "capability", options: filterOptions.capabilities, selected: filters.capability },
            { legend: "Band", name: "band", options: filterOptions.bands, selected: filters.band },
            { legend: "Status", name: "status", options: filterOptions.statuses, selected: filters.status }
          ] %}

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin-top: 1.25rem; font-size: 0.85rem; align-items: start;">
            <div>
              <label for="filter-location" style="font-size: 0.85rem;">Location</label>
              <input
                id="filter-location"
                name="location"
                type="text"
                value="{{ filters.location }}"
                placeholder="e.g. Belfast"
                style="width: 100%; font-size: 0.85rem; padding: 0.4rem 0.6rem;"
              />
            </div>
            <div>
              <label for="filter-closing-date" style="font-size: 0.85rem;">Closing date</label>
              <input
                id="filter-closing-date"
                name="closingDate"
                type="date"
                value="{{ filters.closingDate }}"
                title="Show roles closing on or before this date"
                style="width: 100%; font-size: 0.85rem; padding: 0.4rem 0.6rem;"
              />
            </div>
          </div>

          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1rem;">
            {% for group in groups %}
              {% if group.options.length %}
                <fieldset class="filter-fieldset">
                  <legend>{{ group.legend }}</legend>
                  <details class="filter-dropdown" aria-label="{{ group.legend }} filters">
                    <summary>
                      {{ group.legend }}
                      {% if group.selected.length %}<span class="filter-dropdown-count">{{ group.selected.length }}</span>{% endif %}
                      <span class="filter-dropdown-caret">▼</span>
                    </summary>
                    <div class="filter-dropdown-panel">
                      {% for option in group.options %}
                        <label>
                          <input
                            type="checkbox"
                            name="{{ group.name }}"
                            value="{{ option }}"
                            {% if option in group.selected %}checked{% endif %}
                          />
                          {{ option }}
                        </label>
                      {% endfor %}
                    </div>
                  </details>
                </fieldset>
              {% endif %}
            {% endfor %}
          </div>

          <div style="display: flex; gap: 0.5rem; margin-top: 1rem;">
            <button type="submit" style="font-size: 0.85rem; padding: 0.4rem 1rem;">Apply filters</button>
            {% if hasActiveFilters %}
              <a href="/job-roles" class="btn btn-secondary" style="font-size: 0.85rem; padding: 0.4rem 1rem;">Clear filters</a>
            {% endif %}
          </div>
        </form>
      </div>

      {% if filters.q or filters.capability %}
        <div style="margin-bottom: 1rem; color: var(--kainos-muted);">
          <p style="margin: 0;">
            Filters applied
            {% if filters.q %} - search: "{{ filters.q }}"{% endif %}
            {% if filters.capability %} - role family: {{ filters.capability }}{% endif %}
            <a href="/job-roles" style="margin-left: 0.4rem;">Clear filters</a>
          </p>
        </div>
      {% endif %}

      <div style="margin-bottom: 2rem;">
        <h2 style="margin-top: 0; font-size: 1.3rem; color: var(--kainos-navy);">
          {{ pagination.totalCount }} {% if hasActiveFilters %}Matching{% else %}Open{% endif %} Positions
        </h2>
        <p style="color: var(--kainos-muted); margin: 0.5rem 0 0 0;">
          Showing {{ jobs.length }} of {{ pagination.totalCount }} results (Page {% if pagination.totalPages < 1 %}0{% else %}{{ pagination.currentPage }}{% endif %} of {{ pagination.totalPages }})
        </p>
      </div>

      <div class="job-role-ordering" aria-label="Order job roles">
        <span>Order by:</span>

        <a href="/job-roles?page=1{{ sortQuery('roleName') }}">
          Role name
          {% if ordering.sortBy == "roleName" %}
            {% if ordering.sortOrder == "asc" %}▲{% else %}▼{% endif %}
          {% endif %}
        </a>

        <a href="/job-roles?page=1{{ sortQuery('location') }}">
          Location
          {% if ordering.sortBy == "location" %}
            {% if ordering.sortOrder == "asc" %}▲{% else %}▼{% endif %}
          {% endif %}
        </a>

        <a href="/job-roles?page=1{{ sortQuery('capability') }}">
          Capability
          {% if ordering.sortBy == "capability" %}
            {% if ordering.sortOrder == "asc" %}▲{% else %}▼{% endif %}
          {% endif %}
        </a>

        <a href="/job-roles?page=1{{ sortQuery('band') }}">
          Band
          {% if ordering.sortBy == "band" %}
            {% if ordering.sortOrder == "asc" %}▲{% else %}▼{% endif %}
          {% endif %}
        </a>

        <a href="/job-roles?page=1{{ sortQuery('closingDate') }}">
          Closing date
          {% if ordering.sortBy == "closingDate" %}
            {% if ordering.sortOrder == "asc" %}▲{% else %}▼{% endif %}
          {% endif %}
        </a>

        <a href="/job-roles?page=1{{ sortQuery('status') }}">
          Status
          {% if ordering.sortBy == "status" %}
            {% if ordering.sortOrder == "asc" %}▲{% else %}▼{% endif %}
          {% endif %}
        </a>
      </div>

      <div class="jobs-listing">
        {% for job in jobs %}
          <div class="job-card">
            <div class="job-card-header">
              <div>
                <a href="/job-roles/{{ job.jobRoleId }}" class="job-card-title-link">
                  <h3 class="job-card-title">{{ job.roleName }}</h3>
                </a>
              </div>
              {% if job.status == "Open" %} <span class="job-status-badge open">{{ job.status }}</span> 
              {% else %} <span class="job-status-badge closed">{{ job.status }}</span> 
              {% endif %}

            </div>

            <div class="job-card-meta">
              <span class="job-badge location">📍 {{ job.location }}</span>
              <span class="job-badge">💪{{ job.capability }}</span>
              <span class="job-badge">📊 {{ job.band }}</span>
              {% if job.status == "Open" %} <span class="job-badge">Closes on {{ job.closingDate | formatDate }}</span> {% endif %}
            </div>

            <div style="margin-top: 1rem;">
              <a href="/job-roles/{{ job.jobRoleId }}" class="btn">View Details</a>
              {% if isAdmin %}
                <a href="/job-roles/{{ job.jobRoleId }}/edit" class="btn btn-secondary">Edit</a>
                <form method="post" action="/job-roles/{{ job.jobRoleId }}/delete" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this job role?');">
                  <button type="submit" class="btn btn-secondary">Delete</button>
                </form>
              {% endif %}
            </div>
          </div>
        {% else %}
          <p style="color: var(--kainos-muted);">
            No job roles match your filters.
            {% if hasActiveFilters %}<a href="/job-roles">Clear filters</a>{% endif %}
          </p>
        {% endfor %}
      </div>

      <!-- Pagination Controls -->
      <div class="pagination">
        <a href="/job-roles?page=1{{ filterQuery }}" class="btn {% if not pagination.hasPrev %}btn-disabled{% endif %}" {% if not pagination.hasPrev %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>First</a>
        <a href="/job-roles?page={{ pagination.currentPage - 1 }}{{ filterQuery }}" class="btn {% if not pagination.hasPrev %}btn-disabled{% endif %}" {% if not pagination.hasPrev %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>Previous</a>

        <span class="pagination-status">
          Page {% if pagination.totalPages < 1 %}0{% else %}{{ pagination.currentPage }}{% endif %} of {{ pagination.totalPages }}
        </span>

        <a href="/job-roles?page={{ pagination.currentPage + 1 }}{{ filterQuery }}" class="btn {% if not pagination.hasNext %}btn-disabled{% endif %}" {% if not pagination.hasNext %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>Next</a>
        <a href="/job-roles?page={{ pagination.totalPages }}{{ filterQuery }}" class="btn {% if not pagination.hasNext %}btn-disabled{% endif %}" {% if not pagination.hasNext %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>Last</a>
      </div>

      <div style="text-align: center; margin-top: 2rem;">
        <p style="color: var(--kainos-muted);">
          Can't find what you're looking for?
          <a href="/">Return to home</a> or check back later for new opportunities.
        </p>
      </div>
    </div>
  </section>
{% endblock %}