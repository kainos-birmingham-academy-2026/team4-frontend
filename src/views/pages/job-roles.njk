{% extends "layouts/base.njk" %}

{% block content %}
  <section class="page-section">
    <div class="container">
      <div class="page-header">
        <h1>Explore Job Roles</h1>
        <p>Discover exciting career opportunities across all departments and locations at Kainos</p>
      </div>

      <div style="margin-bottom: 2rem;">
        <form class="search-card" action="#" method="get" aria-label="Filter jobs">
          <label for="search-jobs">Search by title, keyword, or skill</label>
          <div class="search-row">
            <input
              id="search-jobs"
              name="q"
              type="text"
              placeholder="e.g. Software Engineer, React, Data"
            />
            <button type="submit">Search</button>
          </div>
        </form>
      </div>

      <div style="margin-bottom: 2rem;">
        <h2 style="margin-top: 0; font-size: 1.3rem; color: var(--kainos-navy);">
          {{ jobs.length }} Open Positions
        </h2>
      </div>


      <div class="jobs-listing">
        {% for job in jobs %}
          <div class="job-card">
            <div class="job-card-header">
              <div>
                <a href="/job-roles/{{ job.id }}" class="job-card-title-link">
                  <h3 class="job-card-title">{{ job.roleName }}</h3>
                </a>
              </div>
              <span class="job-status-badge open">{{ job.status }}</span>
            </div>

            <div class="job-card-meta">
              <span class="job-badge location">📍 {{ job.location }}</span>
              <!-- <span class="job-badge salary">💰 {{ "Insert Salary" }}</span> -->
              <span class="job-badge">{{ job.capability }}</span>
            </div>

            <p class="job-card-description">Closing date: {{ job.closingDate | formatDate }}</p>


            <!--
            <div>
              <p style="color: var(--kainos-muted); font-weight: 600; font-size: 0.85rem; margin-bottom: 0.5rem;">
                Required Skills
              </p>
              <div class="job-card-tags">
                {% for skill in job.skills %}
                  <span class="tag">{{ skill }}</span>
                {% endfor %}
              </div>
            </div>
            -->

            <div style="margin-top: 1rem;">
              <a href="/job-roles/{{ job.id }}" class="btn">View Details</a>
              <a href="#" class="btn btn-secondary" style="margin-left: 0.5rem;">Save Job</a>
            </div>
          </div>
        {% endfor %}
      </div>

      <div style="text-align: center; margin-top: 3rem;">
        <p style="color: var(--kainos-muted);">
          Can't find what you're looking for?
          <a href="/">Return to home</a> or check back later for new opportunities.
        </p>
      </div>
    </div>
  </section>
{% endblock %}
