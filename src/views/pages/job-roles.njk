{% extends "layouts/base.njk" %}

{% block content %}
  <section class="page-section">
    <div class="container">
      <div class="page-header">
        <h1>Explore Job Roles</h1>
        <p>Discover exciting career opportunities across all departments and locations at Kainos</p>
      </div>

      <div style="margin-bottom: 2rem;">
        <form class="search-card" action="#" method="get" aria-label="Filter jobs">
          <label for="search-jobs">Search by title, keyword, or skill</label>
          <div class="search-row">
            <input
              id="search-jobs"
              name="q"
              type="text"
              placeholder="e.g. Software Engineer, React, Data"
            />
            <button type="submit">Search</button>
          </div>
        </form>
      </div>

      <div style="margin-bottom: 2rem;">
        <h2 style="margin-top: 0; font-size: 1.3rem; color: var(--kainos-navy);">
          {{ pagination.totalCount }} Open Positions
        </h2>
        <p style="color: var(--kainos-muted); margin: 0.5rem 0 0 0;">
          Showing {{ jobs.length }} of {{ pagination.totalCount }} results (Page {{ pagination.currentPage }} of {{ pagination.totalPages }})
        </p>
      </div>


      <div class="jobs-listing">
        {% for job in jobs %}
          <div class="job-card">
            <div class="job-card-header">
              <div>
                <a href="/job-roles/{{ job.jobRoleId }}" class="job-card-title-link">
                  <h3 class="job-card-title">{{ job.roleName }}</h3>
                </a>
              </div>
              {% if job.status == "Open" %} <span class="job-status-badge open">{{ job.status }}</span> 
              {% else %} <span class="job-status-badge closed">{{ job.status }}</span> 
              {% endif %}

            </div>

            <div class="job-card-meta">
              <span class="job-badge location">📍 {{ job.location }}</span>
              <span class="job-badge">💪{{ job.capability }}</span>
              {% if job.status == "Open" %} <span class="job-badge">Closes on {{ job.closingDate | formatDate }}</span> {% endif %}
            </div>

            <div style="margin-top: 1rem;">
              <a href="/job-roles/{{ job.jobRoleId }}" class="btn">View Details</a>
              <a href="#" class="btn btn-secondary" style="margin-left: 0.5rem;">Save Job</a>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Pagination Controls -->
      <div style="display: flex; justify-content: center; gap: 1rem; margin-top: 2rem; padding: 2rem 0; border-top: 1px solid var(--kainos-border);">
        <a href="/job-roles?page=1" class="btn {% if not pagination.hasPrev %}btn-disabled{% endif %}" {% if not pagination.hasPrev %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>First</a>
        <a href="/job-roles?page={{ pagination.currentPage - 1 }}" class="btn {% if not pagination.hasPrev %}btn-disabled{% endif %}" {% if not pagination.hasPrev %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>Previous</a>
        
        <span style="display: flex; align-items: center; padding: 0 1rem; color: var(--kainos-navy); font-weight: 600;">
          Page {{ pagination.currentPage }} of {{ pagination.totalPages }}
        </span>
        
        <a href="/job-roles?page={{ pagination.currentPage + 1 }}" class="btn {% if not pagination.hasNext %}btn-disabled{% endif %}" {% if not pagination.hasNext %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>Next</a>
        <a href="/job-roles?page={{ pagination.totalPages }}" class="btn {% if not pagination.hasNext %}btn-disabled{% endif %}" {% if not pagination.hasNext %}aria-disabled="true" style="pointer-events: none; opacity: 0.5;"{% endif %}>Last</a>
      </div>

      <div style="text-align: center; margin-top: 2rem;">
        <p style="color: var(--kainos-muted);">
          Can't find what you're looking for?
          <a href="/">Return to home</a> or check back later for new opportunities.
        </p>
      </div>
    </div>
  </section>
{% endblock %}
