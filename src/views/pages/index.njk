{% extends "layouts/base.njk" %}

{% block content %}
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Careers at Kainos</p>
      <h1>Build your career on work that matters</h1>
      <p class="hero-copy">
        Explore current openings across engineering, consulting, design, data and
        operations. Every role is listed with its capability, band, location and
        closing date, so you can find the opportunity that fits where you want to
        take your career next.
      </p>

      <a class="btn" href="/job-roles">Browse open roles</a>
    </div>
  </section>

  <section class="intro">
    <div class="container">
      <h2>Find the right opportunity</h2>
      <p>
        Filter live vacancies by capability, band and location to see the roles
        that match your experience. Open each listing for a full description, key
        responsibilities and the number of positions available before you apply.
      </p>
    </div>
  </section>
{% endblock %}
