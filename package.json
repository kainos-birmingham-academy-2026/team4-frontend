{
	"name": "team4-frontend",
	"version": "1.0.0",
	"description": "Team4 Frontend",
	"main": "dist/server.js",
	"scripts": {
		"build": "shx rm -rf dist && tsc && shx cp -r src/views dist/views && tsc -p tsconfig.client.json",
		"dev": "tsc -p tsconfig.client.json && tsx watch src/server.ts",
		"start": "node dist/server.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"prepare": "lefthook install",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:bdd": "cucumber-js --import tsx --import 'tests/bdd/**/*.ts' 'tests/bdd/**/*.feature'",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug",
		"test:ui": "vitest --ui --run",
		"test:coverage": "vitest run --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kainos-birmingham-academy-2026/team4-frontend.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/kainos-birmingham-academy-2026/team4-frontend/issues"
	},
	"homepage": "https://github.com/kainos-birmingham-academy-2026/team4-frontend#readme",
	"dependencies": {
		"axios": "^1.19.0",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"nunjucks": "^3.2.4"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@cucumber/cucumber": "^13.2.1",
		"@playwright/test": "^1.62.1",
		"@types/express": "^5.0.3",
		"@types/express-session": "^1.19.0",
		"@types/node": "^24.2.0",
		"@types/nunjucks": "^3.2.6",
		"@types/supertest": "^7.2.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"chokidar": "^3.6.0",
		"lefthook": "^2.1.10",
		"shx": "^0.4.0",
		"supertest": "^7.2.2",
		"tsx": "^4.20.5",
		"typescript": "^5.9.2",
		"vitest": "^4.1.10"
	}
}
